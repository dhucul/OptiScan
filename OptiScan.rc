#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_OPTISCAN      ICON         "OptiScan.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Embedded PNG assets
//

IDR_TOP_PNG       RCDATA       "assets\\top.png"
IDR_OUTPUT_PNG    RCDATA       "assets\\output.png"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_OPTISCAN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                IDM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Accessible output (read-only)\tCtrl+Shift+A", IDM_TOGGLE_ACCESSIBLE
        MENUITEM SEPARATOR
        MENUITEM "&Clear output",        IDC_INFO_BUTTON33
        MENUITEM SEPARATOR
        POPUP "&Theme"
        BEGIN
            MENUITEM "&Graphite",            IDM_THEME_GRAPHITE
            MENUITEM "&Catppuccin Frappe",   IDM_THEME_CATPPUCCIN
            MENUITEM "&Nord",                IDM_THEME_NORD
            MENUITEM "&Arc-Dark",            IDM_THEME_ARCDARK
            MENUITEM "A&pple Light",         IDM_THEME_APPLELIGHT
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_OPTISCAN ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
    "A",            IDM_TOGGLE_ACCESSIBLE,  VIRTKEY, CONTROL, SHIFT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About OptiScan"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_OPTISCAN,IDC_STATIC,14,14,21,20
    LTEXT           "OptiScan, Version 3.15",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

